#!/bin/bash
set -euo pipefail

SCRIPT_DIR="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"
cd "$SCRIPT_DIR/../.."

echo "==> bash -n"
for script in \
	scripts/install.sh \
	scripts/uninstall.sh \
	scripts/tests/* \
	host/wc-fuse-root \
	host/wc-fuse-supervisor; do
	[ -f "$script" ] || continue
	head -1 "$script" | grep -q '^#!/bin/bash\|^#!/usr/bin/env bash' || continue
	bash -n "$script"
done
echo "    ok: all shell scripts parse"
