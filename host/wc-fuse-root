#!/usr/bin/env bash
# wc-fuse-root.service root helper.
#
# Marks the /dev/wc subtree recursively shared so the per-project FUSE mounts
# the daemon creates under it propagate into the pod via the workspace
# bidirectional bind-mount, and hands the workspace/control directories to the
# invoking user so the unprivileged daemon can create mount points and bind the
# control socket.
set -euo pipefail

user="${1:?usage: wc-fuse-root <user>}"

# /dev/wc is a plain directory inside the /dev devtmpfs mount, and
# `mount --make-rshared` only accepts a mountpoint. Bind /dev/wc to itself
# first so it becomes one (contents unchanged); skip when it already is one, so
# the helper is idempotent.
if ! mountpoint -q /dev/wc; then
	mount --bind /dev/wc /dev/wc
fi
mount --make-rshared /dev/wc

chown "$user" /dev/wc/workspace /dev/wc/control
