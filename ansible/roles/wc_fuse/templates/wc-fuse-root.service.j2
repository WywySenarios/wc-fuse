[Unit]
Description=WywyCode FUSE workspace root setup
After=systemd-tmpfiles-setup.service
Before=systemd-user-sessions.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/sh -c 'set -e; mountpoint -q /dev/wc || mount --bind /dev/wc /dev/wc; mount --make-rshared /dev/wc; chown {{ wc_fuse_user }} /dev/wc/workspace /dev/wc/control'

[Install]
WantedBy=multi-user.target
